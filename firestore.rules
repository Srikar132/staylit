rules_version = '2';

// Staylit Firestore rules. Default is deny; every path below is owner-only
// except groups (members + public discovery).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Per-user data -------------------------------------------------

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // profile/stats, profile/achievements, ...
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /appLimits/{uid}/apps/{pkg} {
      allow read, write: if isOwner(uid);
    }

    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /blockedContent/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /dailyStats/{uid}/days/{date} {
      allow read, write: if isOwner(uid);
    }

    // Scroll damage counts per local day (counts only, no screen content).
    match /scrollStats/{uid}/days/{date} {
      allow read, write: if isOwner(uid);
    }

    match /parental_controls/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /focusSessions/{sessionId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      // userId can never change hands.
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
    }

    // ---- Accountability groups ----------------------------------------

    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isAdmin() {
        return signedIn() && request.auth.uid in resource.data.adminIds;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Joining: a public group may gain exactly one member (the caller).
      function isSelfJoin() {
        return signedIn()
            && resource.data.settings.isPublic == true
            && changed().hasOnly(['memberIds', 'memberFocusTime'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds;
      }

      // Leaving: caller removes only themselves (and their own admin slot).
      function isSelfLeave() {
        return isMember()
            && changed().hasOnly(['memberIds', 'adminIds', 'memberFocusTime'])
            && request.resource.data.memberIds.toSet()
                 == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.adminIds.hasOnly(resource.data.adminIds)
            && !(request.auth.uid in request.resource.data.adminIds);
      }

      // Focus-time counters after a session. Never touches membership, admins
      // or settings.
      function isStatsUpdate() {
        return isMember()
            && changed().hasOnly(['memberFocusTime', 'totalFocusTime'])
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.adminIds == resource.data.adminIds;
      }

      // Queries are `memberIds array-contains uid` or `settings.isPublic == true`,
      // both of which satisfy this condition.
      allow read: if signedIn()
                  && (resource.data.settings.isPublic == true
                      || request.auth.uid in resource.data.memberIds);

      allow create: if signedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid];

      allow update: if isAdmin() || isSelfJoin() || isSelfLeave() || isStatsUpdate();

      allow delete: if isAdmin();

      match /members/{memberId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return signedIn() && request.auth.uid in parentGroup().memberIds;
        }

        function isGroupAdmin() {
          return signedIn() && request.auth.uid in parentGroup().adminIds;
        }

        allow read: if isGroupMember();

        // Own member doc, and only if the group (after this batch) lists the
        // caller as a member. Join updates the group in the same batch.
        allow create: if isOwner(memberId)
                      && request.resource.data.userId == memberId
                      && request.auth.uid in
                           getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Own doc (display name / focus time), or any member refreshing the
        // rank field after a session.
        allow update: if (isOwner(memberId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['displayName', 'focusTime', 'rank']))
                      || (isGroupMember()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank']));

        allow delete: if isOwner(memberId) || isGroupAdmin();
      }
    }
  }
}
